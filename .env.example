# ==============================================================================
# RideMitra — Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit .env or actual production secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
# Server environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Port where Express HTTP server listens
PORT=4000

# API route prefix
API_PREFIX=/api/v1

# Allowed CORS origins (comma-separated list for multiple origins)
# For local dev, allow the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0 - for Phase 2+)
# Phase 1 runtime does not connect to MySQL, but credentials match docker-compose.yml
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ridemitra_dev
DB_USER=ridemitra_user
DB_PASSWORD=ridemitra_dev_password
DB_ROOT_PASSWORD=ridemitra_root_password

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# Vite requires VITE_ prefix for client-accessible environment variables
# ------------------------------------------------------------------------------
# Base URL for API client requests
VITE_API_BASE_URL=http://localhost:4000/api/v1
